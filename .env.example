# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Groq (symptom triage) ---
GROQ_API_KEY=
# mixtral-8x7b-32768 has been decommissioned on Groq; use a current model.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=10

# --- Hospital database (local Excel file, no Google Sheets needed) ---
# Defaults to data/Delhi_Hospital_Bed_Availability.xlsx bundled with this project.
# Point this elsewhere if you have your own hospital dataset in the same format
# (columns: Hospital Name, Area / Zone, Total Beds, General Beds Available,
# ICU Beds Available, Contact Number, Last Updated).
HOSPITAL_DATA_FILE=
HOSPITAL_DATA_SHEET_NAME=Delhi Bed Availability

# --- Email (confirmation / no-beds notifications) ---
# If left blank, emails are logged instead of sent (useful for local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Google Sheet patient intake (used by check_new_patients.py) ---
# The spreadsheet ID — the long string in the Sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Default is pre-set to the shared demo sheet; replace with your own.
SHEET_ID=1jD70uIx-0MZQAvvAOqrahUG4Uajj1MnMiZlzUJj2V-Y

# The gid= query param of the "Form Responses 1" tab.
# To find it:
#   1. Open the spreadsheet in a browser.
#   2. Click the "Form Responses 1" tab at the bottom.
#   3. Look at the URL bar — it ends with something like  #gid=12345678
#   4. Paste that number here.
# "0" is correct when Form Responses 1 is the very first tab in the sheet.
FORM_RESPONSES_GID=0

# Path to the JSON file that tracks which rows have already been processed.
# Default: processed_rows.json in the project root. Change if you prefer
# a different location (e.g. if running from a different directory).
PROCESSED_ROWS_FILE=processed_rows.json
